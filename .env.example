# OpenRouter API Key (required)
OPENROUTER_API_KEY=

# Set to "true" for free hosted tier (locks premium members, shows deploy buttons)
# Leave unset or set to "false" for self-hosted (all features unlocked)
LIMITED_FEATURES=

# Token budgets (optional — defaults shown)
MAX_TOKENS_PER_MEMBER=600
MAX_TOKENS_JUDGE=400

# Per-IP rate limiting (optional — defaults shown: 5 requests per 24h)
RATE_LIMIT=5
RATE_LIMIT_WINDOW_MS=86400000

# Comma-separated list of member IDs to disable entirely (optional)
# Disabled members are hidden from the UI and never called, even on retry
# Valid IDs: pragmatist, skeptic, optimist, devil, risk, mentor, genius, therapist, historian, inventor, guardian
DISABLED_MEMBERS=
